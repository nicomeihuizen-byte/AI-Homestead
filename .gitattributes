# Normalise line endings, once and for all.
#
# Git stores LF in the repository; each working tree gets whatever its platform
# uses. Without this, an editor on Windows re-introduces CRLF and files show as
# full rewrites in `git status` with zero content change.
#
# After changing this file, run:  git add --renormalize .

* text=auto

*.py           text
*.md           text
*.txt          text
*.toml         text
*.cfg          text
*.ini          text
*.json         text
*.yml          text
*.yaml         text
*.sql          text
*.svg          text
*.html         text

# Always LF, regardless of platform: these break with CRLF.
*.sh           text eol=lf

# Binary. Never convert, never diff as text.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.webp         binary
*.ico          binary
*.pdf          binary
*.bsp          binary
*.stl          binary
*.zip          binary
*.npy          binary
